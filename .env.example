# ─── REQUERIDAS (sin estas el app no funciona) ───────────────────────────────
# Supabase — obtener desde: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_public_key

# ─── OPCIONALES (tienen fallback hardcodeado) ─────────────────────────────────
# Backend API REST (por defecto apunta a city-fc-api-v2.vercel.app)
VITE_API_BASE_URL=https://city-fc-api-v2.vercel.app/api

